<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700" prefWidth="1000" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.cincuentazo.controller.controller_juego">

    <!-- Fondo -->
    <ImageView fitHeight="800.0" fitWidth="1200.0" preserveRatio="false">
        <image>
            <Image url="@fondodemesa.jpg" />
        </image>
    </ImageView>

    <!-- Contenedor principal con el resto de la interfaz -->
    <BorderPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>

        <!-- ========== ZONA SUPERIOR: Máquinas ========== -->
        <top>
            <VBox alignment="CENTER" spacing="15">
                <!-- Título zona máquinas -->
                <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;                               -fx-effect: dropshadow(gaussian, black, 10, 0.7, 0, 2);" text="JUGADORES MÁQUINA" />

                <!-- Contenedor de cartas de máquinas -->
                <HBox fx:id="contenedorMaquina" alignment="CENTER" spacing="30">
                    <!-- Las cartas de las máquinas se generarán dinámicamente -->
                </HBox>
            </VBox>
        </top>

        <!-- ========== ZONA IZQUIERDA: Mazo ========== -->
        <left>
            <VBox alignment="CENTER" spacing="15" style="-fx-padding: 20;">
                <!-- Label del mazo -->
                <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;                               -fx-effect: dropshadow(gaussian, black, 8, 0.7, 0, 2);" text="MAZO" />

                <!-- Imagen del mazo -->
                <StackPane>
                    <ImageView fx:id="mazoCartas" fitHeight="140" fitWidth="100" preserveRatio="true">
                        <image>
                            <Image url="@masodecartas.png" />
                        </image>
                    </ImageView>

                    <!-- Badge con cantidad de cartas restantes -->
                    <Label fx:id="labelCartasRestantes" style="-fx-background-color: red; -fx-text-fill: white;                                   -fx-font-size: 14px; -fx-font-weight: bold;                                   -fx-padding: 5 10; -fx-background-radius: 15;" text="52" translateX="-10" translateY="10" StackPane.alignment="TOP_RIGHT" />
                </StackPane>

                <!-- Botón tomar carta -->
                <Button fx:id="btnTomarCarta" onAction="#tomarCarta" style="-fx-background-color: #c41e3a; -fx-text-fill: white;                                -fx-font-size: 16px; -fx-font-weight: bold;                                -fx-background-radius: 10; -fx-padding: 10 20;                                -fx-effect: dropshadow(gaussian, black, 10, 0.5, 0, 3);" text="Tomar Carta" />
            <Button fx:id="btnPasarTurno" onAction="#pasarTurno" style="-fx-background-color: #3B6BE3; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 20; -fx-effect: dropshadow(gaussian, black, 10, 0.5, 0, 3);" text="Pasar Turno" />
            </VBox>
        </left>

        <!-- ========== ZONA CENTRAL: Mesa de juego ========== -->
        <center>
            <VBox alignment="CENTER" spacing="20">

                <!-- Título del juego -->
                <Label style="-fx-text-fill: #FFD700; -fx-font-size: 32px; -fx-font-weight: bold;                               -fx-effect: dropshadow(gaussian, black, 15, 0.8, 0, 3);" text="CINCUENTAZO" />

                <!-- Suma actual -->
                <HBox alignment="CENTER" spacing="10">
                    <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;                                   -fx-effect: dropshadow(gaussian, black, 8, 0.7, 0, 2);" text="SUMA:" />
                    <Label fx:id="labelSumaMesa" style="-fx-text-fill: #FFD700; -fx-font-size: 32px; -fx-font-weight: bold;                                   -fx-effect: dropshadow(gaussian, black, 10, 0.8, 0, 2);" text="0" />
                </HBox>

                <!-- Carta central en juego -->
                <StackPane fx:id="mesaCentral" style="-fx-min-width: 120; -fx-min-height: 160;                                   -fx-max-width: 120; -fx-max-height: 160;                                   -fx-border-color: white; -fx-border-width: 3;                                   -fx-background-color: rgba(255,255,255,0.15);                                   -fx-border-radius: 15; -fx-background-radius: 15;                                   -fx-effect: dropshadow(gaussian, black, 15, 0.6, 0, 4);">
                    <!-- La carta en juego aparecerá aquí -->
                </StackPane>

                <!-- Etiqueta de la mesa -->
                <Label style="-fx-text-fill: white; -fx-font-size: 14px;                               -fx-effect: dropshadow(gaussian, black, 6, 0.7, 0, 1);" text="MESA DE JUEGO" />
            </VBox>
        </center>

        <!-- ========== ZONA DERECHA: Reglas e Información ========== -->
        <right>
            <VBox alignment="CENTER" spacing="15" style="-fx-padding: 20; -fx-background-color: rgba(0,0,0,0.6);                          -fx-background-radius: 15; -fx-border-color: #FFD700;                          -fx-border-width: 2; -fx-border-radius: 15;">

                <Label style="-fx-text-fill: #FFD700; -fx-font-size: 16px; -fx-font-weight: bold;" text="⚡ REGLAS ⚡" />

                <Separator prefWidth="150" style="-fx-background-color: #FFD700;" />

                <VBox spacing="8" style="-fx-padding: 0 10;">
                    <Label style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;" text="🎯 No pasar de 50" />

                    <Label style="-fx-text-fill: #90EE90; -fx-font-size: 11px;" text="📌 2-8, 10: su valor" />
                    <Label style="-fx-text-fill: #87CEEB; -fx-font-size: 11px;" text="📌 9: vale 0" />
                    <Label style="-fx-text-fill: #FFB6C1; -fx-font-size: 11px;" text="📌 J, Q, K: restan 10" />
                    <Label style="-fx-text-fill: #FFFF99; -fx-font-size: 11px;" text="📌 A: vale 1 o 10" />
                </VBox>

                <Separator prefWidth="150" style="-fx-background-color: #FFD700;" />

                <!-- Indicador de turno -->
                <VBox alignment="CENTER" spacing="5">
                    <Label style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;" text="TURNO:" />
                    <Label fx:id="labelTurnoActual" style="-fx-text-fill: #00FF00; -fx-font-size: 14px; -fx-font-weight: bold;" text="Jugador" />
                </VBox>

                <Separator prefWidth="150" style="-fx-background-color: #FFD700;" />

                <!-- Estado del juego -->
                <VBox alignment="CENTER" spacing="5">
                    <Label style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;" text="ESTADO:" />
                    <Label fx:id="labelEstadoJuego" style="-fx-text-fill: yellow; -fx-font-size: 11px;                                   -fx-font-style: italic; -fx-wrap-text: true;                                   -fx-text-alignment: center; -fx-max-width: 140;" text="Juega una carta" />
                </VBox>

            </VBox>
        </right>

        <!-- ========== ZONA INFERIOR: Cartas del jugador ========== -->
        <bottom>
            <VBox alignment="CENTER" spacing="15">

                <!-- Título zona jugador -->
                <VBox alignment="CENTER" spacing="5">
                    <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;                                   -fx-effect: dropshadow(gaussian, black, 10, 0.7, 0, 2);" text="TU MANO" />
                    <Label style="-fx-text-fill: lightgray; -fx-font-size: 12px;                                   -fx-font-style: italic;                                   -fx-effect: dropshadow(gaussian, black, 5, 0.5, 0, 1);" text="Haz clic en una carta para jugarla" />
                </VBox>

                <!-- Contenedor de cartas del jugador -->
                <HBox fx:id="cartasJugador" alignment="CENTER" spacing="20" style="-fx-padding: 15; -fx-min-height: 160;">
                    <!-- Las cartas del jugador se generarán dinámicamente aquí -->
                    <!-- Ya NO usamos botones estáticos, se crean en el controlador -->
                </HBox>

            </VBox>
        </bottom>

    </BorderPane>

</AnchorPane>
